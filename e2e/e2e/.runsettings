<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<TestRunParameters>
		<Parameter name="BaseUrl" value="https://localhost:7224" />
		<Parameter name="ApiUrl" value="https://localhost:7213" />
	</TestRunParameters>
	<Playwright>
		<BrowserName>firefox</BrowserName>
		<LaunchOptions>
			<Headless>true</Headless>
		</LaunchOptions>
		<BrowserNewContextOptions>
			<IgnoreHTTPSErrors>true</IgnoreHTTPSErrors>
		</BrowserNewContextOptions>
	</Playwright>
</RunSettings>